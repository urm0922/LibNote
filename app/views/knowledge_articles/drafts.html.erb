<main class="knowledge-page knowledge-page--drafts">
  <header class="page-header">
    <div>
      <h1>下書きナレッジ一覧</h1>
      <p><%= @knowledge_articles.size %>件の下書きナレッジ</p>
    </div>
    <%= link_to "問い合わせ新規作成", new_inquiry_path, class: "button button-primary" %>
  </header>
  <div class="search-form">
    <%= form_with url:drafts_knowledge_articles_path, method: :get, local: true, class: "search-form__form" do |f| %>
      <div class="search-form__field">
        <%= f.label :q, "キーワード" %>
        <%= f.text_field :q, value: params[:q], placeholder: "タイトル・本文から検索" %>
      </div>
      <div class="search-form__field">
        <%= f.label :category_id, "カテゴリ" %>
        <%= f.collection_select :category_id, @categories, :id, :name, { include_blank: "すべて", selected: params[:category_id] } %>
      </div>
      <div class="search-form__actions">
        <%= f.submit "検索する", name: nil, class: "button button-primary" %>
        <%= link_to "条件クリア", drafts_knowledge_articles_path, class: "button button-secondary"%>
      </div>
    <% end %>
  </div>

  <% if notice.present? %>
    <p class="flash flash-notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="flash flash-alert"><%= alert %></p>
  <% end %>

  <% if @knowledge_articles.any? %>
    <div class="inquiry-list">
      <% @knowledge_articles.each do |knowledge_article| %>
        <article class="list-card">
          <div class="list-card-main">
            <div class="list-card-meta">
              <span><%= knowledge_article.category.name %></span>
              <time datetime="<%= knowledge_article.inquiry.approved_at&.iso8601 %>">
                <%= l knowledge_article.inquiry.approved_at, format: :long %>
              </time>
            </div>
            <h2><%= link_to knowledge_article.title, knowledge_article_path(knowledge_article) %></h2>
            <p><%= truncate(knowledge_article.body, length: 120) %></p>
          </div>
          <% if knowledge_article.inquiry.images.attached? %>
            <% images = knowledge_article.inquiry.images %>
            <% images.each do |image| %>
              <%= image_tag image.variant(resize_to_limit: [225, 175]), class: "inquiry-image", alt: "ナレッジ添付画像" %>
            <% end %>
          <% end %>
          <%= link_to "詳細", knowledge_article_path(knowledge_article), class: "button button-secondary" %>
        </article>
      <% end %>
    </div>
    <%= paginate @knowledge_articles %>
  <% else %>
    <section class="empty-state">
      <h2>下書きナレッジはまだありません</h2>
      <p>問い合わせを作成できます。</p>
      <%= link_to "問い合わせを作成", new_inquiry_path, class: "button button-primary" %>
    </section>
  <% end %>
</main>
