<main class="knowledge-page knowledge-page--show">
  <nav class="page-nav">
    <% if @knowledge_article.published? %>
      <%= link_to "承認済ナレッジ一覧へ戻る", knowledge_articles_path %>
    <% else %>
      <%= link_to "下書きナレッジ一覧へ戻る", drafts_knowledge_articles_path %>
    <% end %>

  </nav>

  <% if notice.present? %>
    <p class="flash flash-notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="flash flash-alert"><%= alert %></p>
  <% end %>

  <article class="inquiry-detail">
    <header class="page-header">
      <div>
        <div class="inquiry-card-meta">
          <span><%= @knowledge_article.category.name %></span>
          <time datetime="<%= @knowledge_article.published_at&.iso8601 %>">
            <% if @knowledge_article.published_at? %>
              <%= l @knowledge_article.published_at, format: :long %>
            <% else %>
              <span>下書き</span>
            <% end %>
          </time>
        </div>
        <h1><%= @knowledge_article.title %></h1>
      </div>
      <% if current_user.admin? %>
        <div class="button-row">
          <%= link_to "編集", edit_knowledge_article_path(@knowledge_article), class: "button button-secondary" %>
          <%= button_to "削除", knowledge_article_path(@knowledge_article), method: :delete, class: "button button-danger", form: { data: { turbo_confirm: "削除してもよろしいですか？" } } %>
        </div>
      <% end %>
    </header>

    <div class="inquiry-body">
      <%= simple_format(@knowledge_article.body) %>
    </div>

    <div class="knowledge-image">
      <% if @knowledge_article.inquiry.images.attached? %>
        <% images = @knowledge_article.inquiry.images %>
        <% images.each do |image| %>
          <%= image_tag image.variant(resize_to_limit: [450, 350]), class: "knowledge_article-image", alt: "ナレッジ添付画像" %>
        <% end %>
      <% end %>
    </div>  
    
    <% if (@knowledge_article.faq_entries.first.present?) && (current_user.admin? || @knowledge_article.faq_enabled == true) %>
      <section id="faq-<%= @knowledge_article.faq_entries.first.id %>" class="FAQ">
        <div class="question ms-5 mt-5">
          <h5>Q1</h5>
            <%= simple_format(@knowledge_article.faq_entries.first.question) %>
        </div>  

        <div class="answer ms-5 mt-5">
          <h5>A1</h5>
            <%= simple_format(@knowledge_article.faq_entries.first.answer) %>
        </div>
      </section>
    <% end %>
    

    <section class="comments ms-5 mt-5 mb-5">
    <h5>関連するやりとり・補足情報</h5>
    <p>コメント件数：<%= @comments.count %> 件</p>
      <% @comments.each do |comment| %>
        <div class="comment-item">
          <div class="comment-meta">
            <%= comment.user.role %>
            <time datetime="<%= comment.created_at.iso8601 %>">
              <%= l comment.created_at, format: :long %>
            </time>
          </div>

          <div class="comment-body">
            <%= simple_format(comment.body) %>
            <% if current_user.admin? %>
              <div class="comment-delete">
                <%= button_to "削除", inquiry_comment_path(@knowledge_article.inquiry, comment), method: :delete, class: "button button-danger", form: { data: { turbo_confirm: "削除してもよろしいですか？" } } %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </section> 
        
    <% if current_user.admin? && @knowledge_article.draft? %>
      <%= button_to "ナレッジを公開する",  publish_knowledge_article_path(@knowledge_article), method: :patch, class: "button button-success" %>
    <% end %>
    <% if current_user.admin? && @knowledge_article.published? %>
      <%= button_to "ナレッジを下書きに戻す",  draft_knowledge_article_path(@knowledge_article), method: :patch, class: "button button-primary" %>
    <% end %>
  </article>
</main>
