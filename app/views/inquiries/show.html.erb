<main class="inquiries-page inquiries-page--show">
  <nav class="page-nav">
    <%= link_to "一覧へ戻る", inquiries_path %>
  </nav>

  <% if notice.present? %>
    <p class="flash flash-notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="flash flash-alert"><%= alert %></p>
  <% end %>

  <article class="inquiry-detail">
    <header class="page-header">
      <div>
        <div class="list-card-meta">
          <span class="status-badge <%= inquiry_status_class(@inquiry) %>">
            <%= inquiry_status_label(@inquiry) %>
          </span>
          <span><%= @inquiry.category.name %></span>
          <span><%= @inquiry.user.name %></span>
          <time datetime="<%= @inquiry.created_at.iso8601 %>">
            <%= l @inquiry.created_at, format: :long %>
          </time>
        </div>
        <h1><%= @inquiry.title %></h1>
      </div>
      <% if policy(@inquiry).update? %>
        <div class="button-row">
          <%= link_to "編集", edit_inquiry_path(@inquiry), class: "button button-secondary" %>
        </div>
      <% end %>
      <% if policy(@inquiry).destroy? %>
        <div class="button-row">
          <%= button_to "削除", inquiry_path(@inquiry), method: :delete, class: "button button-danger", form: { data: { turbo_confirm: "削除してもよろしいですか？" } } %>
        </div>
      <% end %>
    </header>

    <div class="inquiry-body">
      <%= simple_format(@inquiry.body) %>
    </div>

    <div class="inquiry-image">
      <% if @inquiry.images.attached? %>
        <% @inquiry.images.each do |image| %>
          <%= image_tag image.variant(resize_to_limit: [450, 350]), class: "inquiry-image", alt: "問い合わせ添付画像" %>
        <% end %>
      <% end %>
    </div>  
    
    <section class="comments mt-5">
      <% if policy(@comment).create?%>
        <div class="comment-input-form">
          <%= form_with model:[@inquiry, @comment], local: true do |f| %>
            <%= f.text_area :body, rows: 3, placeholder: "コメントする" %>
            <%= f.submit "送信", class: "button button-primary mb-4" %>
          <% end %>
        </div>
      <% end %>

      <p>コメント件数：<%= @comments.count %> 件</p>
      <% @comments.each do |comment| %>
        <%= comment.user.name %>
        <time datetime="<%= comment.created_at.iso8601 %>">
          <%= l comment.created_at, format: :long %>
        </time>
        <%= comment.body %>
        <% if policy(comment).destroy? %>
          <div class="comment-delete">
             <%= button_to "削除", inquiry_comment_path(@inquiry, comment), method: :delete, class: "button button-danger", form: { data: { turbo_confirm: "削除してもよろしいですか？" } } %>
          </div>
        <% end %>
      <% end %>
    </section> 
    <% if policy(@inquiry).can_status_action? %>
      <section class="status-actions">
        <h2>ステータス更新</h2>
        <div class="button-row">
          <% if policy(@inquiry).mark_as_answered? %>
            <%= button_to "回答済みにする", mark_as_answered_inquiry_path(@inquiry), method: :patch, class: "button button-secondary" %>
          <% end %>
          <% if policy(@inquiry).approve? %>
            <%= button_to "承認する", approve_inquiry_path(@inquiry), method: :patch, class: "button button-primary" %>
          <% end %>
          <% if policy(@inquiry).reject? %>
            <%= button_to "差し戻す", reject_inquiry_path(@inquiry), method: :patch, class: "button button-danger" %>
          <% end %>
        </div>
      </section>
    <% end %>
  </article>
</main>
