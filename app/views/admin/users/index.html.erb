<main class="users-page">
  <header class="page-header">
    <div>
      <h1>ユーザー管理</h1>
      <p><%= @users.total_count %>名のユーザー</p>
    </div>
  </header>
  <div class="search-form row mt-3 ms-3 align-self-end">
      <%= form_with url:admin_users_path, method: :get, local: true do |f| %>
        <%= f.text_field :q, value: params[:q], placeholder: "キーワード" %>
        <%= f.label :role, "ステータス" %>
        <%= f.select :role, User.roles.keys.map { |role| [I18n.t("enums.user.role.#{role}"), role] }, { include_blank: "選択してください", selected: params[:role] } %>
        <%= f.submit "検索する", name: nil %>
        <%= link_to "条件クリア", admin_users_path, class: "btn btn-success"%>
      <% end %>
  </div>

  <% if notice.present? %>
    <p class="flash flash-notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="flash flash-alert"><%= alert %></p>
  <% end %>

  <% if @users.any? %>
    <div class="user-list">
      <% @users.each do |user| %>
        <article class="user-card">
          <div class="user-card-main">
            <div class="user-card-meta">
              <span class="role-badge <%= user_role_class(user) %>">
                <%= user_role_label(user) %>
              </span>
              <span><%= user.name %></span>
              <span><%= user.email %></span>
              <time datetime="<%= user.created_at.iso8601 %>">
                <%= l user.created_at, format: :long %>
              </time>
            </div>
          </div>
          <%= link_to "編集", edit_admin_user_path(user), class: "btn btn-success mt-2" %>
        </article>
      <% end %>
    </div>
    <%= paginate @users %>
  <% else %>
    <section class="empty-state">
      <h2>ユーザーが存在しません</h2>
      <%= link_to "ユーザーを作成", new_user_registration_path, class: "button button-primary" %>
    </section>
  <% end %>
</main>
