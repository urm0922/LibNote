<main class="users-page">
  <header class="page-header">
    <div>
      <h1>ユーザー管理</h1>
      <p><%= @users.total_count %>名のユーザー</p>
    </div>
  </header>
  <div class="search-form">
      <%= form_with url:admin_users_path, method: :get, local: true, class: "search-form__form" do |f| %>
      <div class="search-form__field">
        <%= f.label :q, "キーワード" %> 
        <%= f.text_field :q, value: params[:q], placeholder: "ユーザー名から検索" %>
      </div>
      <div class="search-form__field">
        <%= f.label :eq, "Eメール" %> 
        <%= f.text_field :eq, value: params[:eq], placeholder: "Eメールから検索" %>
      </div>
      <div class="search-form__field">  
        <%= f.label :role, "権限" %>
        <%= f.select :role, User.roles.keys.map { |role| [I18n.t("enums.user.role.#{role}"), role] }, { include_blank: "すべて", selected: params[:role] } %>
      </div>
        <div class="user-activate">
          <%= f.label :active, "利用状態" %>
          <%= f.radio_button :active, "true", checked: params[:active] == "true"%>
          <%= f.label :active, "利用中", value: true %>
          <%= f.radio_button :active, "false", checked: params[:active] == "false" %>
          <%= f.label :active, "停止中", value: false %>
        </div>
        <div class="search-form__actions">
          <%= f.submit "検索する", name: nil, class: "button button-primary" %>
          <%= link_to "条件クリア", admin_users_path, class: "button button-secondary"%>
        </div>
      <% end %>
  </div>

  <% if notice.present? %>
    <p class="flash flash-notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="flash flash-alert"><%= alert %></p>
  <% end %>

  <% if @users.any? %>
    <div class="user-list">
      <% @users.each do |user| %>
        <article class="user-card">
          <div class="user-card-main">
            <% if user.active == true %>
              <span class="role-badge active-badge">
                <p>利用中</p>
              </span>
            <% else %>
              <span class="role-badge deactive-badge">
                <p>停止中</p>
              </span>
            <% end %>
            <div class="user-card-meta">
              <span class="role-badge <%= user_role_class(user) %>">
                <%= user_role_label(user) %>
              </span>
              <span><%= user.name %></span>
              <span><%= user.email %></span>
              <time datetime="<%= user.created_at.iso8601 %>">
                <%= l user.created_at, format: :long %>
              </time>
            </div>
          </div>
          <%= link_to "編集", edit_admin_user_path(user), class: "button button-secondary mt-2" %>
        </article>
      <% end %>
    </div>
    <%= paginate @users %>
  <% else %>
    <section class="empty-state">
      <h2>ユーザーが存在しません</h2>
      <%= link_to "ユーザーを作成", new_user_registration_path, class: "button button-primary" %>
    </section>
  <% end %>
</main>
