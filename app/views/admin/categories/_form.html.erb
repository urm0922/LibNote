<%= form_with model: [:admin, category], class: "inquiry-form" do |form| %>
  <% if category.errors.any? %>
    <section class="error-summary">
      <h2><%= category.errors.count %>件のエラーがあります</h2>
      <ul>
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <div class="field">
    <%= form.label :name, "カテゴリ名" %>
    <%= form.text_field :name, required: true, autofocus: true %>
  </div>

  <div class="button-row">
    <%= form.submit category.persisted? ? "更新する" : "作成する", class: "btn btn-primary" %>
    <%= link_to "キャンセル", admin_categories_path, class: "btn btn-secondary" %>
  </div>
<% end %>