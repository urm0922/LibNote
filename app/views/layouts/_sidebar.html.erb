<nav
  id="primary-navigation"
  class="site-header__nav"
  data-mobile-nav-target="menu"
  aria-label="メインメニュー"
>
  <div>
    <%= link_to "トップ",
      root_path,
      class: class_names(
        "nav-link",
        "is-active": current_page?(root_path)
      ) %>
  </div>

  <div>
    <%= link_to "問い合わせ作成",
      new_inquiry_path,
      class: class_names(
        "nav-link",
        "is-active": current_page?(new_inquiry_path)
      ) %>
  </div>

  <div>
    <%= link_to "問い合わせ一覧",
      inquiries_path,
      class: class_names(
        "nav-link",
        "is-active": current_page?(inquiries_path)
      ) %>
  </div>

  <div>
    <%= link_to "下書き一覧",
      confirm_inquiries_path,
      class: class_names(
        "nav-link",
        "is-active": current_page?(confirm_inquiries_path)
      ) %>
  </div>

  <div>
    <%= link_to "承認済ナレッジ一覧",
      knowledge_articles_path,
      class: class_names(
        "nav-link",
        "is-active": current_page?(knowledge_articles_path)
      ) %>
  </div>

  <% if current_user.admin? %>
    <div>
      <%= link_to "下書きナレッジ一覧",
        drafts_knowledge_articles_path,
        class: class_names(
          "nav-link",
          "is-active": current_page?(drafts_knowledge_articles_path)
        ) %>
    </div>
  <% end %>

  <div>
    <%= link_to "承認済FAQ一覧",
      faq_entries_path,
      class: class_names(
        "nav-link",
        "is-active": current_page?(faq_entries_path)
      ) %>
  </div>

  <% if current_user.admin? %>
    <div>
      <%= link_to "カテゴリ管理",
        admin_categories_path,
        class: class_names(
          "nav-link",
          "is-active": current_page?(admin_categories_path)
        ) %>
    </div>

    <div>
      <%= link_to "ユーザー管理",
        admin_users_path,
        class: class_names(
          "nav-link",
          "is-active": current_page?(admin_users_path)
        ) %>
    </div>
  <% end %>

  <div class="nav-user">
    <%= "ユーザー：#{current_user.name} さん" %>
  </div>
  
  <div>
    <%= link_to "ログアウト",
      destroy_user_session_path,
      data: { turbo_method: :delete },
      class: "nav-link" %>
  </div>

</nav>