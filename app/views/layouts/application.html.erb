<!DOCTYPE html>
<html>
  <head>
    <title>Libnote</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= favicon_link_tag('favicon.ico') %>
  </head>

  <body class="<%= "signed-in" if user_signed_in? %>">
    <% if user_signed_in? %>
      <header
        class="site-header"
        data-controller="mobile-nav"
        >
        <div class="site-header__bar">
          <%= link_to root_path, class: "site-header__logo" do %>
            <%= image_tag "header-logo.png", alt: "LibNote" %>
          <% end %>

          <button
            data-action="click->mobile-nav#toggle"
            type="button"
            class="site-header__menu-button"
            aria-label="メニューを開く"
            aria-controls="primary-navigation"
            aria-expanded="false"
          >
          <span></span>
          <span></span>
          <span></span>
          </button>
        </div>

        <%= render "layouts/sidebar" %>
      </header>
    <% end %>
    <%= yield %>
  </body>
</html>
