<!DOCTYPE html>
<html>
  <head>
    <title>Libnote</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= favicon_link_tag('favicon.ico') %>
  </head>

  <body>
    <% if user_signed_in? %>
    <header
      class="site-header"
      data-controller="mobile-nav"
      >
      <div class="site-header__bar">
        <%= link_to root_path, class: "site-header__logo" do %>
          <%= image_tag "header-logo.png", alt: "LibNote" %>
        <% end %>

      <button
        data-action="click->mobile-nav#toggle"
        type="button"
        class="site-header__menu-button"
        aria-label="メニューを開く"
        aria-controls="primary-navigation"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

    <nav data-mobile-nav-target="menu" id="primary-navigation" class="site-header__nav" aria-label="メインメニュー">
      <div><%= link_to "トップ", root_path, class: "nav-link" %></div>
      <div><%= link_to "問い合わせ作成", new_inquiry_path, class: "nav-link" %></div>
      <div><%= link_to "問い合わせ一覧", inquiries_path, class: "nav-link" %></div>
      <div><%= link_to "下書き一覧", confirm_inquiries_path, class: "nav-link" %></div>
      <div><%= link_to "承認済ナレッジ一覧", knowledge_articles_path, class: "nav-link" %></div>
      <% if current_user.admin?%>
        <div><%= link_to "下書きナレッジ一覧", drafts_knowledge_articles_path, class: "nav-link" %></div>
      <% end %>
      <div><%= link_to "承認済FAQ一覧", faq_entries_path, class: "nav-link" %></div>
      <% if current_user.admin?%>
        <div><%= link_to "カテゴリ管理", admin_categories_path, class: "nav-link" %></div>
        <div><%= link_to "ユーザー管理", admin_users_path, class: "nav-link" %></div>
      <% end %>
      <div><%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link" %></div>
      <div class="nav-user"><%= "ユーザー：#{current_user.name} さん" %></div>
    </nav>
    
    </header>
    <% end %>
    <%= yield %>
  </body>
</html>
